Subject: [PATCH] Do not search the block out of current region


diff --git a/net/minecraft/world/level/block/entity/TheEndGatewayBlockEntity.java b/net/minecraft/world/level/block/entity/TheEndGatewayBlockEntity.java
index e29e379f9b2238eafe27545681bb19c710003bcc..af9afb353dd3efcfa26075e5cdd7616f83040190 100644
--- a/net/minecraft/world/level/block/entity/TheEndGatewayBlockEntity.java
+++ b/net/minecraft/world/level/block/entity/TheEndGatewayBlockEntity.java
@@ -427,6 +427,7 @@ public class TheEndGatewayBlockEntity extends TheEndPortalBlockEntity {
                 if (xd != 0 || zd != 0 || allowBedrock) {
                     for (int y = level.getMaxY(); y > (tallest == null ? level.getMinY() : tallest.getY()); y--) {
                         BlockPos pos = new BlockPos(around.getX() + xd, y, around.getZ() + zd);
+                        if (!ca.spottedleaf.moonrise.common.util.TickThread.isTickThreadFor((Level) level, pos)) continue; // Mint - Do not search the block out of current region as we might be at the edge of the tickregion
                         BlockState state = level.getBlockState(pos);
                         if (state.isCollisionShapeFullBlock(level, pos) && (allowBedrock || !state.is(Blocks.BEDROCK))) {
                             tallest = pos;
